# Existing pipeline repository. Defaults to the sibling ../demo directory.
T2I_PIPELINE_ROOT=/absolute/path/to/GEN/demo

# Optional: local quota snapshot. This is read only and must never contain API keys.
# T2I_QUOTA_SNAPSHOT=/absolute/path/to/quota_snapshot.json

# Primary system under test for Agent TestLab. The read-only Requests smoke
# uses ASTERIA_BASE_URL; local pytest uses the checked-in contract suite.
ASTERIA_BASE_URL=http://127.0.0.1:8018
# macOS default is /Users/dora/Developer/asteria-agent. Set this explicitly on Windows/Linux.
# ASTERIA_PROJECT_ROOT=/absolute/path/to/asteria-agent
# Optional Python runtime with Asteria dependencies (for example a conda env).
# ASTERIA_PYTHON=/absolute/path/to/python
# Optional bearer token for future authenticated, read-only suites. Never commit a value.
# ASTERIA_TEST_TOKEN=
